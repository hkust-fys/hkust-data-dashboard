# Copy to .env and fill in your values. Never commit .env.

# --- Production (Discord bot) ---
DISCORD_TOKEN=<your-bot-token>
ANNOUNCE_CHANNEL_ID=<your-channel-id>
# Optional: pin an existing dashboard message (otherwise the bot scans/creates)
# DASHBOARD_MESSAGE_ID=
# Optional: role pinged in the status thread on critical alerts
# (black rainstorm, typhoon signal 8+, heavy congestion)
# ALERT_ROLE_ID=<your-role-id>

# --- Development ---
# DEV_WEBHOOK=<your-development-webhook>

# --- Optional tuning ---
# UPDATE_INTERVAL_SECONDS=30
# HTTP_TIMEOUT_SECONDS=10
# LOG_LEVEL=INFO
# CACHE_DIR=.cache
